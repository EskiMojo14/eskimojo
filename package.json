    "postcss-extend-rule": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.3",
    "stylelint": "^17.16.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "^2.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
