{
  "name": "eskimojo",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#test/*": "./test/*",
    "#.storybook/preview": "./.storybook/preview.tsx"
  },
  "scripts": {
    "dev": "vp dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vp build",
    "coverage": "vp test run --coverage",
    "test:types": "vp test run --project types",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "content:generate": "content-collections build --config config/content-collections.ts",
    "typecheck": "vp run content:generate && tsc --runExternalCode",
    "lint": "vp lint && vpr lint:css:all",
    "preview": "vp preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint:css": "stylelint --config config/stylelint.config.js",
    "lint:css:all": "vpr lint:css \"src/**/*.{css,pcss}\" \".storybook/**/*.css\"",
    "gigs:types": "node scripts/generate-gigs-types.ts",
    "theme:generate": "node scripts/generate-theme.ts",
    "motion:generate": "node scripts/generate-motion.ts",
    "prepare": "vp config",
    "check": "vp check && vpr lint:css:all && vpr typecheck",
    "check:fix": "vp check --fix && vpr lint:css:all --fix && vpr typecheck"
  },
