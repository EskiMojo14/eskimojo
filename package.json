{
  "name": "eskimojo",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#test/*": "./test/*",
    "#.storybook/preview": "./.storybook/preview.tsx"
  },
  "scripts": {
    "dev": "vp dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vp build",
    "coverage": "vp test run --coverage",
    "test:types": "vp test run --project types",
    "lint": "vp lint && vp run lint:css",
    "preview": "vp preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint:css": "stylelint \"src/**/*.css\" \".storybook/**/*.css\"",
    "theme:generate": "node scripts/generate-theme.ts",
    "motion:generate": "node scripts/generate-motion.ts",
    "prepare": "vp config"
  },
  "dependencies": {
    "@tanstack/react-devtools": "0.10.13",
