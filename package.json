    "@tanstack/react-query-devtools": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.3",
    "normalize.css": "^8.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@material/material-color-utilities": "0.4.0",
    "@netlify/vite-plugin-tanstack-start": "^1.3.19",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-mcp": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/tanstack-react": "^10.6.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-plugin-query": "^5.104.5",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/router-cli": "^1.167.45",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "^18.7.0",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-no-relative-import-paths": "^1.7.3",
    "lightningcss": "^1.33.0",
    "mix-n-matchers": "^3.0.0",
    "modern-web-guidance": "^0.0.195",
    "msw": "^3.0.2",
    "msw-storybook-addon": "https://pkg.pr.new/mswjs/msw-storybook-addon@199",
